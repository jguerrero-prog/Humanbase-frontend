---
import {
  AllFeaturesPlot,
  Button,
  Checkbox,
  EffectGroups,
  EffectsControls,
  EffectsHeatmap,
  IconButton,
  MolecularEffects,
  ResultHeader,
  ResultLayout,
  SearchField,
  SegmentedControl,
  Select,
  StrongestEffects,
  VariantFocus,
  VariantScorePlot,
  VariantsTable,
  variantLabel,
} from '@humanbase/ui';
import { Code } from 'astro:components';
import DocSection from '../../components/docs/DocSection.astro';
import DocTable from '../../components/docs/DocTable.astro';
import GenomeTracksSketch from '../../components/docs/GenomeTracksSketch.astro';
import Intro from '../../components/docs/Intro.astro';
import KeyRules from '../../components/docs/KeyRules.astro';
import NoteCard from '../../components/docs/NoteCard.astro';
import ProductScreen from '../../components/docs/ProductScreen.astro';
import { exampleVariants, featureTotal, illustrativeRanks, selectedVariant, strengthCounts, topExperiments } from '../../data/variant-effects';
import DocsLayout from '../../layouts/DocsLayout.astro';

const crumbs = [{ label: 'Jobs', href: '/jobs/' }, { label: 'Seqweaver', href: '/seqweaver/' }, { label: 'Example variants' }];
const context = [
  { name: 'Model', value: 'Seqweaver (RNA)' },
  { name: 'Genome', value: 'GRCh37/hg19' },
  { name: 'Variants', value: '10' },
  { name: 'Finished', value: 'Oct 16, 8:16 PM' },
];
const variantScores = [
  { key: 'impact', label: 'Disease impact' },
  { key: 'evalue', label: 'Mean −log e' },
];
const scoreOptions = [
  { value: 'impact', label: 'Disease impact score' },
  { value: 'evalue', label: 'Mean −log e-value' },
];
const effectScores = [
  { value: 'z', label: 'z-score' },
  { value: 'e', label: 'e-value' },
  { value: 'diff', label: 'Probability diffs' },
];
const cellTypes = [{ value: 'all', label: 'All cell types' }];
const plotBy = [
  { value: 'genome', label: 'Genome position' },
  { value: 'rank', label: 'Rank' },
];

const focus = exampleVariants.find((variant) => variant.id === selectedVariant)!;
const focusLabel = variantLabel(focus);
const effects = new EffectGroups(topExperiments);
const heatmapRows = topExperiments.map((experiment) => ({ experiment, values: [experiment.value] }));
const allValues = [...illustrativeRanks, ...topExperiments.map((experiment) => experiment.value)];
const topLabels = topExperiments.slice(0, 5).map((experiment) => ({ label: experiment.label, value: experiment.value }));
const genes = [
  { name: 'SARS', from: 109_768_000, to: 109_786_000, strand: '+' as const },
  { name: 'CELSR2', from: 109_794_000, to: 109_816_000, strand: '+' as const },
  { name: 'PSRC1', from: 109_822_000, to: 109_826_500, strand: '-' as const },
  { name: 'MYBPHL', from: 109_838_000, to: 109_843_000, strand: '-' as const },
  { name: 'SORT1', from: 109_852_000, to: 109_867_590, strand: '-' as const },
];

const today = [
  ['Header', 'Variant effect predictions; created date and model; Download results.'],
  ['Scores', 'Scatter Plot and Table tabs. Score type: Disease impact score or Mean -log e-value. Plot style: Manhattan (by genome, colored by chromosome, with a chromosome strip) or Score Rank.'],
  ['Variants table', 'Chromosome, Position, Name, Ref Allele, Alt Allele, Disease impact score, Mean -log e-value; search; a chromosome filter; Show data in genomic range.'],
  ['Selection', 'Clicking a variant rings it in the plot, highlights its row and moves the genome browser and effects to it.'],
  ['Genome browser', 'hg19 browser with Disease impact score, Mean -log e-value and GENCODE 19 tracks; location field, zoom slider (200bp to 500kb), add track, print, settings. Redesigned on its own page.'],
  ['Heatmap', 'Molecular-level biochemical effects: z-score, e-value or Probability diffs; search features; Showing top 20 of 232; Reverse Sort; Full View or Compact View; legend -2 to 2 from blue to red.'],
  ['Heatmap cell', 'Tooltip: cell type, feature type, treatment, position and allele change, score (for example Brain, AGO, 9.7).'],
  ['Features', 'For the selected variant, every feature’s score ranked from lowest to highest (232 for Seqweaver).'],
];

const heatmapNotes = [
  'Showing the top 20 of 232 features for this variant. Show more adds 20 at a time.',
  'Shading is binned at |z| 2, 3 and 5, so strong and moderate effects read apart; the exact value sits beside each cell. Bin edges are a display choice to confirm with the team; scores don’t change.',
  'Rows with the same cell type and feature are different experiments; the label adds what tells them apart, from the treatment field (region, replicate, species).',
  'Columns are the variants in the genome browser’s range; here, only the selected one.',
];

const whyBars = [
  ['How strong is it?', 'Shade of one cell, with the number beside it → bar length and the number; strong and weak read at a glance.'],
  ['Which proteins?', '20 rows, with LARP4 four times → 14 proteins; repeats fold into one row with their range and open on click.'],
  ['Does it lower anything?', 'Only by reversing the sort → a Lowers column that says so even when it’s empty.'],
  ['How much is there?', 'Showing top 20 of 232 → a summary by strength first, and a threshold that keeps the list short for Beluga’s 2,002 features.'],
  ['Several variants?', 'Both views work. With two or more variants in range the card opens on Heatmap; Strongest effects then follows the selected variant.'],
  ['What it costs', 'Nothing new from the API: the same scores, grouped by the feature and cell-type fields the tooltip already has.'],
];

const models = [
  ['Seqweaver', 'RNA-binding protein features (232 in this job’s heatmap). Scores: disease impact score, mean −log e-value. Heatmap: z-score, e-value, probability diffs.'],
  ['Beluga', 'Chromatin features (2,002). Same variant scores and heatmap scores as Seqweaver. Strongest effects opens at 3 or more, since 2 or more can list 50 features from 235 experiments.'],
  ['Sei', 'Variant score adds the maximum sequence class score. The heatmap groups the 40 sequence classes into their 8 groups, with a group label down the left edge; the 21,907 chromatin profiles stay in the downloads. Sequence class scores use Legend / Stepped, Type=Sei: seven steps with edges at −2, −1, −0.5, 0.5, 1 and 2, placeholders to confirm with the Sei team (the live site uses a continuous −6 to 6 scale).'],
  ['FASTA or BED input', 'Without alleles there is no variant effect: the page shows predicted feature probabilities for each sequence or interval instead, with the same heatmap and table.'],
];

const words = [
  ['Focus line', 'Selected variant: chr1:109,817,590 G>T, disease impact score 1.00'],
  ['Plot caption', '10 variants. Chromosomes alternate dark and light grey.'],
  ['Heatmap count', 'Showing the top 20 of 232 features for this variant.'],
  ['Search, nothing found', 'No proteins match “LIN28B” for this variant. Search by cell type or protein, such as K562.'],
  ['Genome range filter', 'Only variants in the genome browser’s range: 1 of 10.'],
  ['Model nouns', 'Search, group, column and empty-state labels use the model’s own noun: proteins for Seqweaver, chromatin features for Beluga, sequence classes for Sei, as in “Find a protein or cell type” and “Group experiments by protein”. ExPecto’s tissues aren’t measured in cell types, so its search reads “Find a tissue”, and a tissue measured in two resources, such as Spleen in GTEx and Roadmap, stays as two rows. The third tab names what it plots and follows the chosen score: All features for chromatin, RBP and sequence-class scores; All tissues for ExPecto’s expression effect, switching to All features when a DeepSEA score is chosen.'],
];

const behavior = [
  ['Selection drives the page', 'Clicking a variant in the plot or table, or Previous and Next, moves the genome browser and both effect views. On load the first variant by genome position is selected, as today (chr1:109,817,590 in the example).'],
  ['Plot and table', 'Hovering one highlights the other; sorting the table never changes the plot.'],
  ['Score switches', 'Changing the variant score redraws the plot and re-sorts the table; changing the heatmap score keeps the selected rows in view.'],
  ['Effects views', 'Strongest effects opens first with one variant in range; Heatmap opens first with two or more. Score, threshold, cell type and search apply to all three tabs; grouping by protein applies to Strongest effects. Heatmap rows can be Full or Compact.'],
  ['Downloads', 'Download results lists the files from the job page; the plot’s download gives an image of the plot as shown.'],
  ['URL', 'Selected variant, scores, plot style and heatmap settings are in the URL.'],
];

const specs = [
  ['score plot', 'Main view, 7 columns; points 12px grey 600 and grey 400 by alternating chromosome; selected: 2px ink ring'],
  ['variants table', 'Companion, 5 columns; position and change in Atkinson Hyperlegible Mono 13; selected row grey 100, bold'],
  ['focus line', 'Atkinson Hyperlegible Mono 24 for the variant, Lato 15 grey for its name and score'],
  ['heatmap', 'viz.div scale, 34 by 26px cells with 1px gaps; labels Lato 12 right-aligned; Legend / Diverging beside it'],
  ['all features', 'Points 6px on the diverging scale with a 0.5px grey 600 outline'],
];

const usage = `import { EffectGroups, MolecularEffects, StrongestEffects, VariantScorePlot, VariantsTable } from '@humanbase/ui';

const effects = new EffectGroups(experiments); // feature, cell, context, label, value

<VariantScorePlot variants={variants} score={{ key: 'impact', label: 'Disease impact score' }}
  selected={selected} onSelect={setSelected} summary="10 variants." />
<VariantsTable variants={variants} scores={scores} sortBy="impact" selected={selected} onSelect={setSelected} />

<MolecularEffects variant="chr1:109,817,590 G>T" view={view} onViewChange={setView}>
  <StrongestEffects effects={effects} threshold={2} expanded={open} onToggle={toggle} limit={10} />
</MolecularEffects>`;
---

<DocsLayout title="Variant effect results" description="What Sei, Beluga and Seqweaver jobs return: a score plot and table, the selected variant in the genome browser, and its molecular effects as bars, a heatmap and a ranked plot.">
  <Intro
    lead="What Sei, Beluga and Seqweaver jobs return: a score for every variant, where each variant sits in the genome, and which of hundreds of molecular features it changes. One variant is always the focus, and every view follows it."
    status="Updated October 16, 2026 · UI library · Screens drawn at 1440px on the 12-column grid, shown at 96%"
  >
    <KeyRules
      rules={[
        { title: 'One variant in focus', text: 'Choosing a variant in the plot or the table moves the genome browser and the effects to it. The focus is named above each view.' },
        { title: 'Plot and table together', text: 'Scores are a plot and a table side by side, not two tabs, so people can read values while they look.' },
        { title: 'Direction is blue and orange', text: 'Effects use the diverging scale: blue lowers, orange raises. The legend says which feature and which score.' },
      ]}
    />
  </Intro>

  <DocSection title="What the results page does today" lead="From the Seqweaver example job submitted on October 16, 2026 (10 variants, GRCh37/hg19). Everything here stays; only presentation changes.">
    <DocTable caption="The variant results page today" columns={['Part', 'Today']} widths={['240px']}>
      {today.map(([part, text]) => <tr><th scope="row">{part}</th><td>{text}</td></tr>)}
    </DocTable>
  </DocSection>

  <DocSection title="The results page" lead="The top of a Seqweaver result on the Results layout: the score plot as the main view and the variants table beside it. The example job’s real values.">
    <ProductScreen label="A Seqweaver result at 1440px: scores" current="Sequence analysis">
      <ResultLayout mainLabel="Variants plotted by disease impact score" companionLabel="Variants">
        <ResultHeader slot="header" headingLevel={3} crumbs={crumbs} title="Example variants" context={context} settingsLabel="Job actions">
          <Fragment slot="settings">
            <Button variant="ghost" size="small" icon="link">Copy link</Button>
            <Button variant="secondary" icon="download">Download results</Button>
          </Fragment>
        </ResultHeader>
        <Fragment slot="main">
          <div class="plot-controls">
            <Select label="Score" size="small" options={scoreOptions} value="impact" />
            <SegmentedControl label="Plot by" size="small" segments={plotBy} value="genome" />
            <IconButton icon="download" label="Download the plot" />
          </div>
          <VariantScorePlot variants={exampleVariants} score={{ key: 'impact', label: 'Disease impact score' }} selected={selectedVariant} summary="The 9 of the example’s 10 variants that Figma records. Chromosomes alternate dark and light grey; position carries the chromosome, so color doesn’t have to." />
        </Fragment>
        <Fragment slot="companion">
          <SearchField label="Filter by name or position" placeholder="Filter by name or position" size="medium" />
          <VariantsTable variants={exampleVariants} scores={variantScores} sortBy="impact" selected={selectedVariant} />
          <Checkbox label="Only variants in the genome browser’s range" />
        </Fragment>
      </ResultLayout>
    </ProductScreen>
    <p class="note">The example job lists 10 variants; Figma names 9 of them, so the table here holds those 9.</p>
  </DocSection>

  <DocSection title="A variant in focus" lead="Below the scores, everything follows the selected variant: where it sits in the genome, then which molecular features it changes. The effects card opens on Strongest effects.">
    <ProductScreen label="A Seqweaver result at 1440px: the selected variant" current="Sequence analysis">
      <VariantFocus label={focusLabel} detail={`${focus.name}, disease impact score ${focus.scores.impact?.toFixed(2)}`} />
      <figure class="browser-sketch" data-illustration>
        <figcaption><strong>Genome browser, GRCh37/hg19</strong> chr1:109,767,590-109,867,590 (100 kb)</figcaption>
        <GenomeTracksSketch start={109_767_590} end={109_867_590} ticks={[109_780_000, 109_800_000, 109_820_000, 109_840_000, 109_860_000]} variant={{ position: focus.position, label: focusLabel, scores: [1, 0.9] }} scoreMax={3} genes={genes} />
        <p>The browser is redesigned on the Genome browser page. Here it centers on the selected variant and keeps the result’s two score tracks.</p>
      </figure>
      <MolecularEffects variant={focusLabel} view="strongest">
        <EffectsControls scores={effectScores} score="z" threshold={2} cellTypes={cellTypes} search="" groupByFeature />
        <StrongestEffects effects={effects} counts={strengthCounts} threshold={2} expanded={['LARP4']} limit={10} />
      </MolecularEffects>
    </ProductScreen>
  </DocSection>

  <DocSection title="Heatmap view" lead="The second tab of the same card: one row per experiment, one column per variant in the genome browser’s range, the value beside each cell, and Show 20 more. With two or more variants in range it opens on this tab, since comparing variants is what a heatmap is for.">
    <div class="card-with-notes">
      <MolecularEffects variant={focusLabel} view="heatmap">
        <EffectsControls scores={effectScores} score="z" search="" density="full" lowestFirst={false} />
        <EffectsHeatmap variants={[focusLabel]} rows={heatmapRows} total={featureTotal} initialActive={[2, 0]} />
      </MolecularEffects>
      <div class="notes">
        {heatmapNotes.map((note) => <p>{note}</p>)}
      </div>
    </div>
  </DocSection>

  <DocSection title="All features" lead="All features is the third tab of the same card. It plots every feature’s score for the selected variant, lowest to highest, so the few strong effects stand out against the rest, and marks where the heatmap’s top 20 come from. Hovering a point shows the cell tooltip; clicking it finds that row in the heatmap.">
    <MolecularEffects variant={focusLabel} view="all">
      <EffectsControls scores={effectScores} score="z" />
      <div data-illustration>
        <AllFeaturesPlot
          values={allValues}
          labels={topLabels}
          summary="z-score of all 232 features for chr1:109,817,590 G>T, lowest to highest. The top 20 are the real values from the example; ranks 1 to 212 are illustrative, following the shape of the live plot, because their exact values weren’t captured."
        />
      </div>
    </MolecularEffects>
  </DocSection>

  <DocSection title="Why Strongest effects is the default" lead="The decision, October 16, 2026: bars by protein open first; the heatmap stays one tab away, and becomes the first tab when variants are compared.">
    <DocTable caption="Heatmap view against Strongest effects" columns={['Question', 'Heatmap view → Strongest effects view']} widths={['300px']}>
      {whyBars.map(([question, answer]) => <tr><th scope="row">{question}</th><td>{answer}</td></tr>)}
    </DocTable>
  </DocSection>

  <DocSection title="Sei and Beluga on the same page" lead="The layout is the same for all three models; only scores, features and grouping change, as each model computes them.">
    <DocTable caption="What changes by model" columns={['Model', 'What changes']} widths={['300px']}>
      {models.map(([model, change]) => <tr><th scope="row">{model}</th><td>{change}</td></tr>)}
    </DocTable>
  </DocSection>

  <DocSection title="Words" lead="Variants in the mono font with commas in positions; scores as computed (Scientific notation and units).">
    <DocTable caption="What the page says" columns={['Moment', 'What it says']} widths={['300px']}>
      {words.map(([moment, text]) => <tr><th scope="row">{moment}</th><td>{text}</td></tr>)}
    </DocTable>
  </DocSection>

  <DocSection title="Behavior" lead="What every variant result does the same way.">
    <DocTable caption="Variant result behavior" columns={['Rule', 'Detail']} widths={['300px']}>
      {behavior.map(([rule, detail]) => <tr><th scope="row">{rule}</th><td>{detail}</td></tr>)}
    </DocTable>
  </DocSection>

  <DocSection title="Specs" lead="Hard-coded for now. They will become Figma variables once the first product pages are designed.">
    <DocTable caption="Variant result specs" columns={['Part', 'Value']} widths={['380px']}>
      {specs.map(([part, value]) => <tr><th scope="row"><code>{part}</code></th><td>{value}</td></tr>)}
    </DocTable>
  </DocSection>

  <NoteCard title="Using the components in code">
    <p>Pages own the selected variant and pass it to every view, so the plot, table, browser and effects always agree. <code>EffectGroups</code> folds experiments of one feature, splits raises from lowers and counts effects by strength.</p>
    <Code code={usage} lang="tsx" theme="css-variables" />
  </NoteCard>
</DocsLayout>

<style>
  .plot-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: end;
  }

  .plot-controls :global(.select) {
    inline-size: 240px;
  }

  .note,
  .browser-sketch p {
    font: var(--type-caption);
    color: var(--text-secondary);
  }

  .browser-sketch {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-6);
    border: var(--border-width-1) solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .browser-sketch figcaption {
    display: flex;
    gap: var(--space-3);
    font: var(--type-body-sm);
    color: var(--text-secondary);
  }

  .browser-sketch strong {
    font: var(--type-label-sm);
    color: var(--text-default);
  }

  .card-with-notes {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  @media (width < 80rem) {
    .card-with-notes {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .notes {
    display: grid;
    gap: var(--space-3);
    max-inline-size: 720px;
    font: var(--type-body-sm);
    color: var(--text-secondary);
  }
</style>
