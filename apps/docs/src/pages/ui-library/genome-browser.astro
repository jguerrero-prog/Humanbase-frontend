---
import { assemblyProblem, GenomeLocation, SampleClient, SampleGenomeTracks } from '@humanbase/data';
import { geneDetails, isSegmentTrack, scoreDetails, segmentDetails, suggestedTracks } from '@humanbase/genome';
import { ActionMenu, BrowserSettingsDialog, DataTooltip, ExportDialog, GenomeBrowserToolbar, GenomeTrackFigure, Heatmap, SegmentTable, TrackHeader, TrackSettingsDialog, TracksDrawer, genomeBrowserKeyHelp, type ActionMenuItem } from '@humanbase/ui';
import { Code } from 'astro:components';
import DocSection from '../../components/docs/DocSection.astro';
import DocTable from '../../components/docs/DocTable.astro';
import GenomeTracksSketch from '../../components/docs/GenomeTracksSketch.astro';
import Intro from '../../components/docs/Intro.astro';
import KeyRules from '../../components/docs/KeyRules.astro';
import NoteCard from '../../components/docs/NoteCard.astro';
import { scoreLegends } from '../../data/score-legends';
import DocsLayout from '../../layouts/DocsLayout.astro';

const view = new GenomeLocation('chr1', 109_767_590, 109_867_590);
const trackCount = 3;
const variant = { position: 109_817_590, label: 'chr1:109,817,590 G>T', scores: [1, 0.9] };
const genes = [
  { name: 'CELSR2', from: 109_794_000, to: 109_816_000, strand: '+' as const },
  { name: 'PSRC1', from: 109_822_000, to: 109_826_500, strand: '-' as const },
  { name: 'MYBPHL', from: 109_830_000, to: 109_836_000, strand: '-' as const },
  { name: 'SORT1', from: 109_838_000, to: 109_842_590, strand: '-' as const },
];
const tracks = [
  { name: 'Disease impact score', source: 'This job', scale: 'scale 0 to 3' },
  { name: 'Mean −log e-value', source: 'This job', scale: 'scale 0 to 3' },
  { name: 'Genes', source: 'GENCODE 19' },
];
// Only score tracks have Track settings: height and value range are what their bars can change.
const trackMenuOf = (scores: boolean): ActionMenuItem[] => [
  ...(scores ? [{ label: 'Track settings…' }] : []),
  { label: 'Move up', dividerBefore: scores },
  { label: 'Move down' },
  { label: 'Remove track', destructive: true, dividerBefore: true },
];
const trackMenu = trackMenuOf(true);
const moreMenu: ActionMenuItem[] = [{ label: 'Browser settings…' }, { label: 'Clear highlights' }];
const suggested = [
  { id: 'impact', label: 'Disease impact score', source: 'This job', shown: true },
  { id: 'evalue', label: 'Mean −log e-value', source: 'This job', shown: true },
  { id: 'genes', label: 'Genes', source: 'GENCODE 19', shown: true },
  { id: 'sequence', label: 'Genome sequence', source: 'Bases appear from about 200 bp', shown: true },
  { id: 'conservation', label: 'Conservation', source: 'Suggested track, as today', shown: false },
  { id: 'chromhmm', label: 'GM12878 ChromHMM', source: 'Genome segmentation', shown: false },
  { id: 'yours', label: 'H3K27ac', source: 'Your file, 0 to 40', shown: true, removable: true },
];
const trackSettings = { name: 'Disease impact score', height: '60', min: '0', max: '3' };
const browserSettings = { reverseTrackpad: false, reverseButtons: false, highlightLocation: false, guideline: 'left' };

const today = [
  ['Location', 'A field that takes a location or gene name (“1:109,767,590..109,867,590”). The assembly is only in the section title, “Genome browser (hg19)”.'],
  ['Zoom', 'Zoom in (+) and out (-), and a slider with 200bp, 2kb, 50kb and 500kb stops; Space toggles between two zoom levels.'],
  ['Jump', '« and » jump to the previous or next feature in the selected track (ctrl+left, ctrl+right): in a result, the previous or next variant.'],
  ['Add track (A)', 'A panel with Defaults (Conservation, GM12878 ChromHMM, GENCODE 19, Genome, and the job’s score tracks, as checkboxes), DAS, Files, and + for a new source by URL.'],
  ['Configure track (E)', 'About the track with Download data; Name, Pin to top, Height, Style (Histogram, Line Plot, Ribbon, Scatter), Colours, Min and Max value, Threshold leap, Reset track.'],
  ['Export (X)', 'Export as SVG; include highlights, include vertical guideline, width in pixels, label with genomic coordinates.'],
  ['Options', 'Reverse trackpad scrolling, reverse scrolling buttons and keys, vertical guideline position, highlight current location, Reset browser.'],
  ['Tracks', 'Ruler; Disease impact score and Mean -log e-value (ASD: DNA and RNA disease impact scores, from -0.5 to 3); GENCODE 19 genes with names and strand arrows. Clear highlights (C).'],
  ['Linked views', 'The browser follows the selected variant. In the ASD Browser the heatmap’s columns are the variants in view, in genomic order; selecting one centers both.'],
  ['Gaps', 'Icon buttons have tooltips but no accessible names; track names sit on top of the data; the panels open beside the tracks and shrink them; ASD heatmap row labels are cut off on the left.'],
];

const heatmapNotes = [
  'The same three tabs as on Variant effect results. Today’s Heatmap and Features tabs become Heatmap and All features; Strongest effects is added. The card opens on Heatmap, as humanbase.io’s does.',
  'Columns stay in genomic order. Close variants pack side by side; a strip just above them repeats the browser’s positions, and a thin line runs from each column to its exact place on it, so packing never hides where a variant is.',
  'The center variant’s column is outlined in ink and its line is darker; its bars in the score tracks are ink.',
  'DNA features and RNA features stay a select above the heatmap, as today; the stepped z-score legend sits beside it.',
  'Hovering a cell shows the data tooltip; hovering a column highlights its line and its bars in the browser.',
  'Clicking a column’s line selects that variant and centers the browser on it at the same width, as humanbase.io’s column labels do. Each line is a button named “Center on” and the variant.',
  'Dragging the cells moves the browser by the same share of its width as the drag is of the heatmap’s width, as on humanbase.io; a single move over 100px is ignored.',
  'View: Full keeps every variant in view. Compact keeps one variant per 15px of the heatmap’s width, as humanbase.io does: the center variant, or else the one with the higher variant score.',
];
const heatmapColumns = [2_232_996, 2_234_187, 2_235_106, 2_235_168, 2_235_624, 2_247_509, 2_250_950, 2_254_905, 2_255_213, 2_259_317];
const zLegend = scoreLegends[0]!.spec;
// Illustrative values in the same repeating pattern as the earlier diagram, one per diverging step.
const stepValues = [-4, -2.5, 0, 2.5, 4, 6];
const heatmapRows = Array.from({ length: 12 }, (_, row) => ({
  label: `Feature ${row + 1}`,
  values: heatmapColumns.map((_, column) => stepValues[(row * 7 + column * 3) % stepValues.length]!),
}));

const keyboard = [
  ...genomeBrowserKeyHelp,
  ['Screen readers', `The browser region is labeled with its location, such as “${view.regionLabel(trackCount)}”; View as table lists the variants and genes in view with positions and scores.`],
  ['Focus', 'Tab reaches the toolbar, each track header’s menu, the tracks, then the items of each track with details; the 2px focus ring from Tokens shows on all of them.'],
  ['On an item', 'Arrow keys, Home and End move between the items of that track; Enter or Space opens its details; Tab moves on to the next track.'],
];

const integration = [
  ['Hide the built-in toolbar and panels', 'The system toolbar, Tracks drawer and dialogs replace them; Biodalliance already drives location, zoom, tracks and export through its API.'],
  ['Track header column', 'Names, sources and scales move out of the data area into a fixed column, so labels never sit on top of bars.'],
  ['Track colors from the system', 'Score tracks use viz.seq step 6 (#1F5FAE); the selected variant is ink. Gene exons stay grey 600.'],
  ['Location in words', 'Show chr1:109,767,590-109,867,590 with commas and the assembly beside it; accept today’s 1:109,767,590..109,867,590 format too.'],
  ['Linked heatmap', 'Column positions and the center variant come from the browser’s view, as today; the connectors read the same positions.'],
  ['Remember choices', 'Tracks, their order and settings are kept in this browser, like other preferences (no accounts). Reset to default tracks puts all three back.'],
];

const words = [
  ['Location help', view.help()],
  ['Gene not found', GenomeLocation.geneNotFound('ILB1')],
  ['Out of range', new GenomeLocation('chr1', 249_240_000, 249_290_000).clamp(249_250_621).message ?? ''],
  ['Track loading', 'Loading GENCODE 19…'],
  ['Track failed', 'GM12878 ChromHMM didn’t load. Try again, or remove it from Tracks.'],
  ['Outside the sample data', 'With the API off, one info Alert under the tracks replaces every track’s message: “Sample data covers only the area around each example variant. Turn the API on to browse the whole genome.” Tracks you added still draw from their own file.'],
  ['Nothing in view', 'No variants in this range. Previous variant and Next variant jump to the nearest ones.'],
  ['Track added', 'H3K27ac is added and shown.'],
  ['Added, not kept', 'H3K27ac is added for this visit only. This browser wouldn’t store it, so add it again next time.'],
  ['Wrong assembly', assemblyProblem(['chr1', 'chr2'].map((name) => ({ name, length: GenomeLocation.chromosomes('hg38')[name] ?? 0 })), 'hg19', 'H3K27ac.bw') ?? ''],
  ['Not an indexed file', '“peaks.bed” is a text file. Convert BED to bigBed with bedToBigBed, or bedGraph and WIG to bigWig with bedGraphToBigWig or wigToBigWig, then add that file.'],
  ['Not a track file', '“signal.bw” isn’t a bigWig or bigBed file.'],
  ['Not shown yet', '“reads.bam” can’t be shown here yet. Add a bigWig or bigBed file.'],
  ['Server won’t share', 'Humanbase couldn’t read the file at example.org. Its server has to let other sites read it (CORS) and answer byte-range requests, or it may be offline.'],
  ['No byte ranges', 'example.org sent the whole file instead of the parts asked for. Its server has to answer byte-range requests.'],
  ['Already added', 'That address is already in Tracks.'],
];

const yourTracks = [
  ['Formats', 'bigWig for scores and bigBed for segments: indexed files that the browser reads in parts, as it reads Humanbase’s own tracks. Text formats (BED, bedGraph, WIG) need converting with UCSC’s bedToBigBed, bedGraphToBigWig or wigToBigWig first. BAM, CRAM, VCF and GFF would need new track types, so they say so instead of loading.'],
  ['Size', 'No limit. Only the bytes for the view are read, so large files work.'],
  ['Your file', 'Read in this browser with the File API and never uploaded; Humanbase has no accounts and no server copy.'],
  ['By URL', 'An http or https address whose server allows other sites to read it (CORS, with the Range header allowed and Content-Range exposed) and answers byte-range requests with 206. Humanbase’s own track files on S3 do.'],
  ['Assembly check', 'The file’s chromosome lengths are compared with the browser’s assembly (chromosomeSizes.json, from UCSC). A file on the other assembly says which one it is on; any other mismatch names the chromosome. Files that name chromosomes 1, 2 and X instead of chr1 are read with those names.'],
  ['Drawing', 'A bigWig draws as viz.seq step 6 bars, as Conservation does, from the file’s lowest value (or 0) to its highest, read from the file’s summary; the header says the range. A bigBed draws as GM12878 ChromHMM does: boxes in the file’s own itemRgb colors, or viz.seq step 6 (the browser’s track color) for a file with no itemRgb, listed under View as table.'],
  ['Name and source', 'The file’s name without .bw or .bb, numbered when it repeats one in the list. The line under it says Your file, or the address’s host, then the range.'],
  ['Listed', 'In All tracks after the suggested tracks, on when added, with a Remove button. The drawer goes back to All tracks once a track is added and says so. In the browser they have the same track menu as other tracks, and a bigWig has Track settings.'],
  ['Remembered', 'In this browser’s IndexedDB, files included, for each genome browser and assembly. If the browser won’t store a file, such as when it’s larger than the browser allows, the track lasts for this visit and the drawer says so.'],
  ['Export', 'Shown tracks you added are in the SVG export like any other track.'],
  ['Reset to default tracks', 'Resets which tracks show, their order and their settings. It doesn’t delete tracks you added; Remove does.'],
  ['Biodalliance', 'The alternative engine reads tracks added by URL itself. Files from your computer are read only by the default engine.'],
];

const behavior = [
  ['Follows the selection', 'On a result, selecting a variant centers the browser on it at the current zoom. Moving the browser by hand doesn’t change the selection.'],
  ['Zoom stops', '200 bp, 2 kb, 50 kb and 500 kb, as today; the view can sit between stops, and the field shows the exact width.'],
  ['Tracks', 'The job’s score tracks and genes are on by default. Suggested tracks are listed off; Your file and By URL add a bigWig or bigBed track of your own. Remove track in a track menu hides a track; Remove beside a track you added, in All tracks, deletes it from this browser.'],
  ['Track menu', 'Each track header has one. Move up and Move down swap the track with the next shown track, and are off at the top and bottom. Remove track hides it; Tracks turns it back on. Focus stays on the track’s menu button, or goes to the tracks once the track is gone.'],
  ['Track settings', 'Score tracks only: Height, 50 to 300 px (60 by default), and the lowest and highest values the bars span (the track’s own range by default). Apply checks the fields and says what to fix; Reset track goes back to the defaults. Other tracks have nothing their data lets you change, so their menu has no Track settings.'],
  ['Not yet', 'Today’s Line, Ribbon and Scatter styles, colors, threshold leap, Pin to top, renaming, About this track and Download track data wait for a drawing spec and a download format.'],
  ['Export', `SVG for publication with today’s options; the file is named after the location, such as ${view.fileName()}.`],
  ['Panels', 'Tracks is a drawer over the page; settings and export are dialogs. None of them resizes the tracks.'],
  ['URL', 'Location and tracks are in the URL, so a view can be shared.'],
];

const specs = [
  ['toolbar', '12px by 16px padding, 12px gaps; labeled buttons for Previous variant, Tracks, Export, Next variant; 36px icon buttons with tooltip and shortcut; every control centered on the location field’s 44px line; when the row is too narrow, Tracks, Export and Next variant wrap together; on a phone the padding is 12px by 0, and when the zoom buttons and stops can’t share a line, the stops take their own line below the buttons, in full'],
  ['location', 'Search field medium, 400px; assembly Lato Bold 12 grey and width Lato 12 grey under it'],
  ['track header', '220px column, grey 50; name Lato Bold 13; source and scale Lato 12 grey; 28px menu button'],
  ['ruler and positions', 'Atkinson Hyperlegible Mono 11 grey 600 with commas; ticks every tenth of the view'],
  ['score tracks', 'viz.seq step 6 bars; selected variant ink with its value in Lato Bold 11'],
  ['selected variant', '1px ink line at 50% through all tracks; mono label on an ink pill'],
  ['item details', 'Data tooltip, 280px, elevation 2; title Lato Bold 14 and a 28px round close button with a 16px x; 6px arrow; 8px from the item'],
  ['linked heatmap', '16px columns in genomic order; 0.75px grey connectors to the ruler; center column 2px ink outline'],
];

// The ChromHMM drawing reads the recorded sample of gm12878.ChromHMM.bb, the same segments the browser draws.
const chromHmm = suggestedTracks.hg19.find(isSegmentTrack)!;
const sampleFiles = new SampleGenomeTracks(SampleClient.bundled());
const chromSpan = { chrom: view.chrom, start: view.start, end: view.end };
const chromSegments = await sampleFiles.segments(chromHmm.bigBedUrl, chromSpan);
const chromGenes = await sampleFiles.genes('hg19', chromSpan);
const chromTrack = { name: chromHmm.name, meta: chromHmm.meta ?? '', state: 'ready' as const, data: chromSegments };
const hovered = chromSegments.find((segment) => segment.start <= variant.position && segment.end >= variant.position)!;
const count = new Intl.NumberFormat('en-US');
const chromRules = [
  ['Same as humanbase.io', 'Each segment is an 8px box filled with the file’s color for that segment and a 1px black outline, with no labels and no stacking, as humanbase.io’s browser config draws it.'],
  ['State names', 'Shown as the file’s state codes, such as Tss, EnhW, Ctcf, ReprW and Quies, as on humanbase.io. Plain-language names, a legend or any regrouping would change how the output reads, so they need a research ticket for subject-matter experts first.'],
  ['Hover', 'The Data tooltip gives the state code, the source, the start and the length of the segment.'],
  ['Click', 'Opens the item details popover with Location and Score, the fields humanbase.io lists (see Item details).'],
  ['Never color alone', 'The state code is in the tooltip and in View as table, which lists each segment’s code, start, end and length.'],
  ['Where it appears', 'Suggested tracks on hg19 results and the ASD Browser, off until turned on, as on humanbase.io. Not listed on hg38. Source: humanbase.s3.amazonaws.com/tracks/gm12878.ChromHMM.bb.'],
  ['Export', 'Included in the SVG export at the export width.'],
];

// The item details popover lists what humanbase.io's genome browser lists for each track, checked in Playwright on October 22, 2026.
const detailGene = chromGenes.find((gene) => gene.name === 'CELSR2')!;
// The ASD Browser's DNA disease impact score at PEX10, as the live file and humanbase.io give it; the bundled sample is rounded.
const detailScore = { start: 2_346_202, end: 2_346_202, value: 3.6189358234405518 };
const itemDetailRules = [
  ['Opens', 'Clicking a score bar, a gene or a segment, or Enter or Space on a focused one. Clicking between bars opens nothing. A drag never opens it: a press becomes a drag after 4px.'],
  ['Fields', 'Exactly what humanbase.io lists for that track. Genes (GENCODE): Method, the transcript type; Location; Score, from the file. GM12878 ChromHMM: Location and Score. Score tracks (DNA and RNA disease impact scores, Conservation): Location and Score, the value read from the file at full precision, such as 3.6189358234405518. Anything more, such as links or exon counts, needs a research ticket for subject-matter experts first.'],
  ['ExPecto link', 'humanbase.io’s DNA disease impact score adds a “View in ExPecto” row that opens ExPecto for that position. It’s left out until ExPecto here can open a position; today it opens genes only.'],
  ['Score bars', 'A bar’s Location is the stretch it covers: one base for each disease impact score, or the bases under one pixel when the view summarises a file such as Conservation. Its Score is the value the bar draws.'],
  ['Title', 'The track’s name, as in its header. No hint line.'],
  ['Stays until', 'Close, Escape, a click outside, or moving the view by dragging, keys or the toolbar. Only one is open at a time: opening another item closes the first.'],
  ['Placement', 'Centered under the item with the 6px arrow pointing at it; above it when there isn’t room below. Always inside the browser area.'],
  ['The open item', 'Outlined 2px ink, as a hovered heatmap cell is.'],
  ['Hover', 'Segment tracks keep their hover Data tooltip; it doesn’t show while a popover is open.'],
  ['Where', 'The ASD Browser and every variant result’s browser, on score tracks, genes and GM12878 ChromHMM.'],
  ['Biodalliance', 'The alternative engine keeps its own click behavior.'],
];
const itemDetailStates = [
  ['Closed', 'The item as drawn; the pointer becomes a hand over it.'],
  ['Focused', 'The 2px focus ring around the item’s area: a score bar, at least 24px tall and inside its track; a gene’s bar and name; or a segment’s box.'],
  ['Open', 'The item is outlined 2px ink and the popover is pinned under it, focus on its close button.'],
  ['Open, no room below', 'The popover sits above the item and the arrow points down.'],
];
const itemDetailAccess = [
  ['Role', 'A non-modal dialog named by the track, such as “Genes”. Each item is a button named by its gene; its state code and position, such as “ReprW, 109,816,601 to 109,818,400”; or its value to 2 decimals and position, such as “3.62 at 2,346,202”. Each says it opens a dialog and whether it’s open.'],
  ['Focus', 'Moves to the close button when it opens and returns to the item on Close or Escape. Each track’s items are one tab stop.'],
  ['Close button', '28px, round, with the 16px x icon, named “Close”.'],
  ['Contrast', 'The Data tooltip’s: white on ink 17.4:1, labels in grey 300 11.4:1.'],
];

const usage = `import { GenomeLocation } from '@humanbase/data';
import { GenomeBrowserToolbar, TrackHeader, TracksDrawer, genomeCommand } from '@humanbase/ui';

const view = GenomeLocation.parse('1:109,767,590..109,867,590');
<GenomeBrowserToolbar location={view.format()} assembly={view.assemblyName} widthHelp="100 kb shown. A gene name works too."
  zoomStop={view.width} onZoom={(direction) => engine.zoomTo(view.zoom(direction))} />

// One place maps keys to commands; the Biodalliance adapter carries them out.
element.addEventListener('keydown', (event) => run(genomeCommand(event)));`;
---

<DocsLayout title="Genome browser" description="The genome browser: the design system draws its tracks, toolbar, track headers, panels and words; Biodalliance stays available as an alternative engine.">
  <Intro
    lead="Variant results and the ASD Browser show variants in their genomic context. The design system draws the tracks itself from the same Humanbase track files the live site reads, and replaces what people see and touch around them: the toolbar, track headers, panels and words. Biodalliance, the open-source browser the live site uses, stays available as an alternative engine."
    status="Updated October 23, 2026 · UI library · Screens drawn at 1440px on the 12-column grid, shown at 96%"
  >
    <KeyRules
      rules={[
        { title: 'Always say where you are', text: 'Location, assembly and the width of the view are always written out, such as chr1:109,767,590-109,867,590, GRCh37/hg19, 100 kb.' },
        { title: 'Every control has a name', text: 'Frequent actions are labeled buttons; the rest are icon buttons with a tooltip that also gives the shortcut.' },
        { title: 'Tracks explain themselves', text: 'Each track header says what it shows, its scale and where it comes from, with its settings one click away.' },
      ]}
    />
  </Intro>

  <DocSection title="What the browser does today" lead="Biodalliance on the Seqweaver example result and the ASD Browser, captured with Playwright on October 16, 2026. Every function stays.">
    <DocTable caption="The genome browser today" columns={['Part', 'Today']} widths={['240px']}>
      {today.map(([part, text]) => <tr><th scope="row">{part}</th><td>{text}</td></tr>)}
    </DocTable>
  </DocSection>

  <DocSection title="The browser" lead="On a variant result, centered on the selected variant with 50 kb either side (100 kb), as on humanbase.io. The toolbar, track headers and tracks are system components; the tracks follow the specs below. Gene positions in this drawing are approximate.">
    <section class="browser" aria-label={view.regionLabel(trackCount)}>
      <GenomeBrowserToolbar location={view.format()} assembly={view.assemblyName} widthHelp="100 kb shown. A gene name works too." moreItems={moreMenu} />
      <div class="browser-tracks">
        <div class="track-column">
          <div class="track-column-ruler">Position</div>
          {tracks.map((track) => <TrackHeader name={track.name} source={track.source} scale={track.scale} menuItems={trackMenuOf(Boolean(track.scale))} />)}
        </div>
        <div class="track-area" data-illustration>
          <GenomeTracksSketch
            start={view.start}
            end={view.end}
            ticks={[109_800_000, 109_810_000, 109_820_000, 109_830_000, 109_840_000]}
            variant={variant}
            scoreMax={3}
            genes={genes}
          />
        </div>
      </div>
    </section>
    <p class="browser-help">Drag to move along the genome. Scroll with Ctrl or pinch to zoom. Keyboard: arrow keys move, + and - zoom, Ctrl and arrows jump between variants. <a href="#in-view">View as table</a></p>
    <DocTable caption="In view: variants and genes" columns={['Item', 'Position', 'Value']} widths={['260px', '360px']}>
      <tr id="in-view"><th scope="row">{variant.label}</th><td>{variant.label.split(' ')[0]}, {view.assemblyName}</td><td>Disease impact score 1.00, Mean −log e-value 0.90</td></tr>
      {genes.map((gene) => <tr><th scope="row">{gene.name}</th><td>Approximate, {gene.strand === '+' ? 'forward' : 'reverse'} strand</td><td>GENCODE 19</td></tr>)}
    </DocTable>
  </DocSection>

  <DocSection title="Tracks, track settings and export" lead="Today these panels open beside the tracks and squeeze them. Here Tracks opens as a drawer over the page, track settings start from a menu on each track header, and export and options are dialogs. Track settings offer only what a track’s data can change (Behavior lists what waits).">
    <div class="panels" inert>
      <figure>
        <figcaption>Tracks drawer</figcaption>
        <TracksDrawer inline tracks={suggested} />
      </figure>
      <figure>
        <figcaption>Track menu, then Track settings</figcaption>
        <div class="menu-specimen">
          <ActionMenu label="Disease impact score track options" items={trackMenu} open size="small" />
        </div>
        <TrackSettingsDialog inline settings={trackSettings} />
      </figure>
      <figure>
        <figcaption>Export, and Browser settings</figcaption>
        <ExportDialog inline />
        <BrowserSettingsDialog inline settings={browserSettings} />
      </figure>
    </div>
  </DocSection>

  <DocSection title="Your tracks" lead="Your file and By URL in the Tracks drawer add a bigWig or bigBed track of your own beside Humanbase’s, as the live site’s Files and + do. Everything stays in your browser.">
    <DocTable caption="Your tracks rules" columns={['Rule', 'Detail']} widths={['240px']}>
      {yourTracks.map(([rule, detail]) => <tr><th scope="row">{rule}</th><td>{detail}</td></tr>)}
    </DocTable>
  </DocSection>

  <DocSection title="Browser and heatmap together (ASD Browser)" lead="With many variants in view, the heatmap sits under the browser: one column per variant in genomic order, rows sorted by the size of the center variant’s effect. Clicking a column, or dragging the heatmap, changes the center, and both views follow, as today.">
    <Heatmap
      client:visible
      title="DNA features, z-score"
      summary="z-score. Showing the top 20 of 2,002 features, sorted by chr1:2,337,101 A>C. Cells are illustrative."
      scale={zLegend}
      columns={heatmapColumns.map((position) => ({ label: String(position), position }))}
      rows={heatmapRows}
      rowHeader="Feature"
      columnHeader="Position"
      axis={{ title: 'Position on chr1, GRCh37/hg19', offset: 2_230_000, ticks: [5_000, 10_000, 15_000, 20_000, 25_000] }}
      decimals={1}
    />
    <ul class="points">
      {heatmapNotes.map((note) => <li>{note}</li>)}
    </ul>
  </DocSection>

  <DocSection title="Keyboard and screen readers" lead="The browser keeps every shortcut it has today. The new toolbar names each control and gives the browser a text alternative.">
    <DocTable caption="Keys and what they do" columns={['Key or need', 'What happens']} widths={['240px']}>
      {keyboard.map(([key, text]) => <tr><th scope="row">{key}</th><td>{text}</td></tr>)}
    </DocTable>
  </DocSection>

  <DocSection title="What the Biodalliance integration needs" lead="Biodalliance stays available as an alternative engine. The system toolbar and panels call its existing interface instead of showing its own, so nothing about the data or scores changes. For the team building the front end.">
    <DocTable caption="What the Biodalliance adapter needs" columns={['Need', 'Why']} widths={['320px']}>
      {integration.map(([need, why]) => <tr><th scope="row">{need}</th><td>{why}</td></tr>)}
    </DocTable>
    <NoteCard title="Using the engine in code">
      <ul>
        <li>Pages talk to one interface, <code>GenomeBrowserEngine</code> in <code>@humanbase/genome</code>: mount, show a region, mark the selected variant, and report when a drag or zoom settles.</li>
        <li>The default engine, <code>TrackEngine</code>, draws <code>GenomeTrackView</code> from <code>@humanbase/ui</code>: the ruler, the sequence (letters once a base is 7px wide), the score tracks as <code>viz-seq-6</code> bars, GENCODE genes with names and strand arrows, and the selected variant as a 50% ink line with its value and a mono pill. Drag the tracks to move along the genome.</li>
        <li>Track menus and Track settings go through the same interface: <code>arrangeTracks</code> takes the tracks' order and each score track's height and range, by track id, and <code>GenomeEngineView</code> takes <code>arrangement</code> and <code>trackMenu</code>. <code>TrackEngine</code> draws the menus in its own headers; Biodalliance reorders its tiers and sets their height, <code>forceMin</code> and <code>forceMax</code>.</li>
        <li>Items open their details when the page gives them <code>details</code>: <code>geneDetails</code> and <code>segmentDetails</code> in <code>@humanbase/genome</code> list humanbase.io’s fields, and <code>GenomeTrackView</code> draws the popover with <code>DataTooltip</code> and <code>placeUnderBox</code>. An item without details doesn’t open one.</li>
        <li>Segment tracks, such as GM12878 ChromHMM, read a bigBed file through <code>GenomeTracks.segments</code> and draw each segment as an 8px box in the file’s own color; <code>SegmentTable</code> lists them under View as table, under either engine.</li>
        <li>It reads the same files as the live site through <code>GenomeTracks</code> in <code>@humanbase/data</code>: the hg19 genome, GENCODE 19 genes and the DNA and RNA impact tracks from Humanbase's files on S3, in byte ranges. With the API off it reads recorded windows of those files from the sample data and makes no request.</li>
        <li>Biodalliance is vendored in the repository with its licenses and takes this page's look when chosen: its own toolbar, labels, Bootstrap and Font Awesome are off and its options take tokens. Its ruler, gene labels and grid are drawn on its canvas and keep its look. The package README lists every setting.</li>
        <li>To use another Biodalliance setup, edit <code>humanbaseConfig.ts</code> or pass your own options and <code>baseUrl</code>. To use Biodalliance or another engine, return it from <code>defaultGenomeEngine</code>, or pass <code>engine</code> to the page. The package README has the details.</li>
      </ul>
    </NoteCard>
  </DocSection>

