---
import { withBase } from '../../withBase';
import { contrastRatio, lightness } from '@humanbase/tokens/color';
import { chromosomeColor, KeyLegend, ScaleLegend, sequenceClassLegend, VariantScorePlot } from '@humanbase/ui';
import DocSection from '../../components/docs/DocSection.astro';
import DocTable from '../../components/docs/DocTable.astro';
import Intro from '../../components/docs/Intro.astro';
import KeyRules from '../../components/docs/KeyRules.astro';
import BarChart from '../../components/viz/BarChart.astro';
import EffectTrack from '../../components/viz/EffectTrack.astro';
import HeatmapDiagram from '../../components/viz/HeatmapDiagram.astro';
import NetworkDiagram from '../../components/viz/NetworkDiagram.astro';
import ScaleRamp from '../../components/viz/ScaleRamp.astro';
import { colors } from '../../data/colors';
import { exampleVariants, selectedVariant } from '../../data/variant-effects';
import { edgeBands, enrichedTerms, modules, promoterTrack, tissueScores, variantEffects } from '../../data/viz-examples';
import DocsLayout from '../../layouts/DocsLayout.astro';

const white = colors.hex('color.white');
const ratio = (hex: string) => `${contrastRatio(hex, white).toFixed(2)}:1`;
const step = (key: string) => {
  const hex = colors.hex(`viz.${key}`);
  return { color: `var(--viz-${key.replace('.', '-')})`, label: hex, note: `L ${Math.round(lightness(hex))}`, dark: contrastRatio(hex, white) > 4.5 };
};
const sequential = ['seq.1', 'seq.2', 'seq.3', 'seq.4', 'seq.5', 'seq.6', 'seq.7'].map(step);
const diverging = ['div.n3', 'div.n2', 'div.n1', 'div.0', 'div.p1', 'div.p2', 'div.p3'].map(step);
const categorical = [
  ['cat.1', 'Blue'],
  ['cat.2', 'Orange'],
  ['cat.3', 'Indigo'],
  ['cat.4', 'Reddish purple'],
  ['cat.5', 'Sky blue'],
  ['cat.6', 'Vermilion'],
  ['cat.other', 'Other'],
].map(([key = '', name], index, all) => {
  const hex = colors.hex(`viz.${key}`);
  return { name: index < all.length - 1 ? `${index + 1}. ${name}` : name, cssVar: `--viz-${key.replace('.', '-')}`, hex, ratio: ratio(hex) };
});
const moduleScale = ['Blue', 'Vermilion', 'Teal', 'Violet', 'Brown', 'Purple', 'Gold', 'Wine'].map((name, index) => {
  const hex = colors.hex(`viz.module.${index + 1}`);
  return { name: `${index + 1}. ${name}`, cssVar: `--viz-module-${index + 1}`, hex, ratio: ratio(hex) };
});

const bandItems = [
  { label: `Dark ${colors.hex('viz.band.dark')}`, color: '--viz-band-dark' },
  { label: `Light ${colors.hex('viz.band.light')}`, color: '--viz-band-light' },
  { label: `Neutral ${colors.hex('viz.band.neutral')}`, color: '--viz-band-neutral' },
];
const chromosomeItems = [...Array.from({ length: 22 }, (_, i) => `chr${i + 1}`), 'chrX', 'chrY'].map((label) => ({ label, color: chromosomeColor(label) ?? '' }));
const moduleItems = modules.map(({ id, label }) => ({ label, color: id === 'other' ? '--viz-cat-other' : `--viz-module-${id}` }));
const edgeItems = [...edgeBands].reverse();


const aroundRenderer: [string, string, { text: string; href: string }?][] = [
  ['Toolbar above the graph', 'Icon buttons with tooltips and accessible names (Tooltips page): zoom, fit, expand, download and starred sets.'],
  ['Legend', 'The Legend components beside the graph, with a title. The connection legend lists only the bands the minimum confidence leaves on screen.'],
  ['Filters and sliders', 'Minimum confidence and number of genes, in a filter group or drawer (Accordions page). Uses the Slider component.', { text: 'Slider component', href: withBase('/components/sliders/') }],
  ['Hovering a gene', 'A Data tooltip with its name and score; genes and connections it doesn’t touch fade to 20%, and a gene in a module draws its connections.'],
  ['Hovering a connection', 'It thickens, and a Data tooltip names both genes and its confidence.'],
  ['Clicking a gene or connection', 'Opens the drawer beside the graph (Modals and drawers page), not a new page or tab level. Clicking empty space or pressing Escape clears it.'],
  ['Module list', 'The table beside the module graph shows each module’s name in words next to its color. Hovering a row brings that module forward in the graph, and hovering a module in the graph highlights its row.'],
  ['View as table', 'Every graph can switch to the gene table with the same data.'],
];

const requests = [
  ['Edges on the sequential blue ramp, by darkness, width and opacity', 'humanbase.io’s green to red scale is the pairing this page measures as failing for red-green color blindness, and green reads as “selected” in this system.'],
  ['The layout settles before it is drawn, and never moves after', 'humanbase.io’s layout moves for several seconds after loading. Running the simulation before the first draw removes the motion the Motion page warns about.'],
  ['Everything fits the panel, labels included', 'On humanbase.io, labels at the edge are cut off and Expand view crops genes.'],
  ['Labels never overlap', 'A label moves below, right or left of its gene when the spot above is taken, and shows only on hover when there is no free spot.'],
  ['Each module labeled on its own outline', 'humanbase.io places module labels around the outside of the graph, often far from their cluster, and small modules mix together.'],
  ['Eight module colors, then the same colors as rings', 'The first 16 modules each keep a color of their own, where the graph used to turn grey after the sixth.'],
];

const accessibility = [
  ['Summary first', 'Each chart starts with one sentence that says what it shows: “IL1B’s 50 most related genes in blood vessel; the strongest is IL1R1 at 0.97.”'],
  ['View as table', 'Every chart can switch to a table with the same data, using the Tables page components.'],
  ['Keyboard', 'Nodes, cells and bars can be reached with Tab and the arrow keys; focus shows the data tooltip and the 2px ink outline.'],
  ['Not color alone', 'Strength is darkness and width; direction is color and position; groups are color and the legend, with the module name in the tooltip.'],
  ['Contrast', 'Lines and small marks on white are 3:1 or more (sequential step 5 and up). Filled category marks have a grey 600 outline.'],
  ['Checked', 'Every scale on this page was tested with simulated protanopia, deuteranopia and tritanopia. Re-test any new scale the same way.'],
];

const specs = [
  ['viz.seq.1 to .7', sequential.map((s) => s.label).join(' ')],
  ['viz.div.-3 to +3', diverging.map((s) => s.label).join(' ')],
  ['viz.cat.1 to .6, other', `${categorical.slice(0, -1).map((c) => c.hex).join(' ')}; other ${categorical.at(-1)?.hex}`],
  ['viz.module.1 to .8', `${moduleScale.map((c) => c.hex).join(' ')}; modules 9 to 16 reuse them as 2px rings with a dashed outline; past 16, other`],
  ['viz.edge', 'Curved, bending the same way; ≥ 0.9: seq.7, 2.5px, full; 0.75 to 0.9: seq.6, 1.75px, 80%; 0.5 to 0.75: seq.5, 1px, 60%; the weakest band starts at the minimum confidence, such as 0.84 to 0.9; over 80 connections, all at 55% of that. In modules, connections inside a module take its color and those between modules are grey at 45%'],
  ['viz.node', '12px, white with 1.5px grey 600 outline; query gene 20px, white with a 2.5px ink outline, pulled to the middle; fixed size, except module genes: 12px to 20px by 1 plus their connections, as on humanbase.io'],
  ['viz.selection', '2px ink ring, 4px out from the node; others at 30% opacity. Hover: a dashed ring, others at 20%'],
  ['viz.module.outline', 'A hull 10px around the module’s genes, its color at 7% with a 1px outline at 40%; the module label sits on its top edge in a white pill with a 1.5px outline in its color, 14px on screen at any zoom'],
  ['viz.highlight (starred sets)', 'A 3.5px ring per starred set in viz.cat.1 to .6, in starring order, stacked outward; a 1px ink edge outside the last ring; a hull of the same color at 12% behind the set'],
  ['viz.label', 'Lato Bold 12 ink on a white pill at 85%, above the gene; query gene 14; drawn over every connection'],
  ['viz.heatmap.cell', '34px with a 1px white gap; missing: white, grey 300 outline and diagonal'],
  ['viz.axis', 'Lato 12 grey 600 labels; Lato Bold 12 ink titles with units; 1px grey 200 gridlines'],
  ['viz.bar', 'grey 600 when color encodes nothing; 20px tall, 2px end radius'],
  ['viz.legend', 'Legend / Sequential, Diverging, Categorical and Edge strength components; beside the chart'],
];

// The don'ts show colors the system rules out, so they are written here rather than taken from tokens.
const rainbow = ['#301934', '#4A62D8', '#2EA8F5', '#1BE0B8', '#7CFC5A', '#C9F02D', '#F9C03A', '#F7731C', '#D02C04', '#7A0402'].map((color) => ({ color }));
const redGreen = ['#1A9850', '#66BD63', '#A6D96A', 'transparent', '#FDAE61', '#F46D43', '#D73027'].map((color) => ({ color }));
---

<DocsLayout title="Data visualization" description="Color scales, network diagrams, heatmaps and charts that stay readable for every kind of color vision.">
  <Intro
    lead="Humanbase is mostly charts: functional networks, expression heatmaps, enrichment bars and variant effects along a sequence. These rules keep them honest and readable for everyone, including the roughly 1 in 12 men and 1 in 200 women with a color vision deficiency."
    status="Updated October 22, 2026 · Usage guideline · Colors checked with simulated protanopia, deuteranopia and tritanopia (Machado 2009)"
  >
    <KeyRules
      rules={[
        { title: 'Green is not data', text: 'Emerald belongs to the interface: brand and selection. Charts never use it, so a green mark never looks “selected”.' },
        { title: 'One scale per kind of data', text: 'Amounts get one blue ramp, directions get blue to orange, groups get six named colors. Never a rainbow. Two sets copy humanbase.io instead: Sei sequence classes and chromosomes.' },
        { title: 'Color is never alone', text: 'Every encoding is also in a label, a position, a line width or a table view, and every chart has a legend.' },
      ]}
    />
  </Intro>

  <DocSection title="Color scales" lead="Three scales cover Humanbase. Pick by what the number means, not by what looks nice.">
    <article class="scale-card">
      <header><h3>Sequential: amounts</h3><code>viz.seq.1 to viz.seq.7</code></header>
      <p>For values from low to high: network scores from 0 to 1, expression levels, edge confidence. Darker means more.</p>
      <ScaleRamp steps={sequential} />
      <p class="ends"><span>0 (low)</span><span>1 (high)</span></p>
      <ul class="points">
        <li>Lightness drops in even steps of about 10 to 14, so each step looks like “more”, in color and in grey scale.</li>
        <li>Steps 1 to 4 are below 3:1 against white. In heatmaps, cells touch each other and the legend carries the meaning; on white, lines and small marks use step 5 or darker (4.1:1 and up).</li>
      </ul>
    </article>
    <article class="scale-card">
      <header><h3>Diverging: direction</h3><code>viz.div.-3 to viz.div.+3</code></header>
      <p>For values with a meaningful middle: z-scores, and whether a variant raises or lowers expression or chromatin activity. Blue below the middle, orange above.</p>
      <ScaleRamp steps={diverging} />
      <p class="ends"><span>Decrease</span><span>No change</span><span>Increase</span></p>
      <ul class="points">
        <li>Never red to green. Under simulated protanopia, a red and green pair loses about 83% of its difference; this blue and orange pair keeps it (difference 90 to 105 in all three simulations).</li>
        <li>Both sides darken at the same rate, so a −2 and a +2 look equally strong. The middle is grey 50, not white, so it still reads as a value.</li>
      </ul>
    </article>
    <article class="scale-card">
      <header><h3>Categorical: groups</h3><code>viz.cat.1 to viz.cat.7</code></header>
      <p>For groups with no order: evidence types, tissue systems, starred sets. Five colors from the Okabe–Ito set and indigo from Paul Tol’s, chosen so none is green, plus grey for “other”. More than six groups means labels, not more colors. Modules have a scale of their own, below.</p>
      <ul class="swatches">
        {
          categorical.map(({ name, cssVar, hex, ratio: onWhite }) => (
            <li>
              <span class="swatch" style={`background: var(${cssVar})`} />
              <strong>{name}</strong>
              <code>{hex} {onWhite}</code>
            </li>
          ))
        }
      </ul>
      <ul class="points">
        <li>The closest pair stays clearly apart in every simulation (smallest difference 17 to 21, against 26 for typical vision). Indigo replaced Okabe–Ito’s bluish green, which sat close to emerald and tested worse.</li>
        <li>Orange, sky blue and the grey are under 3:1 on white, so filled marks always get a 1px grey 600 outline. The outline meets the 3:1 rule for graphics; the fill tells groups apart.</li>
        <li>Use them in this order, so the first groups get the most distinct colors.</li>
      </ul>
    </article>
    <article class="scale-card">
      <header><h3>Categorical: modules</h3><code>viz.module.1 to viz.module.8</code></header>
      <p>For the clusters of the module graph, which often has more than six. None is green, which means selected in this system. Each color is 3:1 or more on white, so a gene reads without an outline, and each module keeps its color when filters hide others.</p>
      <ul class="swatches">
        {
          moduleScale.map(({ name, cssVar, hex, ratio: onWhite }) => (
            <li>
              <span class="swatch" style={`background: var(${cssVar})`} />
              <strong>{name}</strong>
              <code>{hex} {onWhite}</code>
            </li>
          ))
        }
      </ul>
      <ul class="points">
        <li>In this order, neighbors stay apart under simulated protanopia, deuteranopia and tritanopia (smallest difference 14.5) and for typical vision (24.1).</li>
        <li>Modules 9 to 16 reuse the colors as rings with a dashed outline, so a second cue tells them apart from the module that shares their color. Past 16, modules are grey.</li>
        <li>Every module is also labeled on its outline and named in the table, so color is never the only cue.</li>
      </ul>
    </article>
    <article class="scale-card">
      <header><h3>Sei sequence classes</h3><code>viz.seqclass.*</code></header>
      <p>An exception to the six categorical colors: Sei’s eight sequence class groups keep the colors humanbase.io gives them, so a plot colored by sequence class reads the same on both sites. Only the Sei plot’s Color style, Sequence class, uses them.</p>
      <KeyLegend title="Sequence class" items={sequenceClassLegend} />
      <ul class="points">
        <li>A class is matched to its group by the start of its name, as on humanbase.io: E for Enhancer, PC for Polycomb before P for Promoter, HET, TN, TF, L.</li>
        <li>Points get the 1px outline every filled category mark gets, and the class is also named in the variants table.</li>
        <li>The legend keeps humanbase.io’s label text exactly, including its spelling “Heterochomatin”.</li>
      </ul>
    </article>
    <article class="scale-card">
      <header><h3>Chromosomes</h3><code>viz.chromosome.1 to .22, .x, .y</code></header>
      <p>The second exception to the six categorical colors: the variant score plot colors each of the 24 chromosomes the way humanbase.io does, so a result reads the same on both sites. The values are the ones humanbase.io renders, from its distinct-colors palette (24 colors, hue 50 to 340, chroma 0 to 90, lightness 45 to 80), read from the live site on October 21, 2026.</p>
      <KeyLegend title="Chromosome" items={chromosomeItems} />
      <ul class="points">
        <li>Only the variant score plot uses them, in every DeepSEA result, and in Sei’s Color style, Chromosome.</li>
        <li>Neighboring chromosomes can look alike, so the axis labels and the variants table carry the chromosome too; color is never the only cue.</li>
      </ul>
    </article>
    <article class="scale-card">
      <header><h3>Score plot bands</h3><code>viz.band.dark, .light, .neutral</code></header>
      <p>The greys humanbase.io draws under the variant score plot’s overview, so the strip reads the same on both sites. They mark where each chromosome runs; they carry no value.</p>
      <KeyLegend title="Overview band" items={bandItems} />
      <ul class="points">
        <li>Dark and light alternate by chromosome when Sei’s Color style is Sequence class, since the points then no longer show chromosome colors.</li>
        <li>Neutral is the single band under Score Rank, where the x axis is rank, not position.</li>
        <li>With Color style Chromosome, each band takes its chromosome’s viz.chromosome color instead.</li>
      </ul>
    </article>
  </DocSection>

  <DocSection
    title="Network graphs (2D; 3D views need D3.js)"
    lead="The tissue network and module graphs follow humanbase.io’s look: curved connections, white genes with bold labels, and modules as colored clusters. They keep every function and fix what makes the live graphs hard to read."
  >
    <section class="renderer-note" aria-labelledby="renderer-today">
      <h3 id="renderer-today">What humanbase.io does (captured with Playwright, October 16 and 27, 2026)</h3>
      <p>Both views are drawn by d3 in SVG. The IL1B tissue network draws its 54 connections as curved arcs, each twice, colored on a green to orange to red confidence scale, with white genes and bold labels above them. Hovering a gene does nothing; hovering a connection thickens it.</p>
      <p>The module graph draws each module as a cluster of genes sized by their connections, in muted colors, with M labels around the outside of the graph. Hovering a gene names it and fades the other modules; hovering a module in the table does nothing in the graph.</p>
      <p>The tissue network’s layout keeps moving for several seconds after the page loads, labels collide or are cut off at the edge, and Expand view crops genes.</p>
    </section>
    <p class="caption">These diagrams follow the renderer’s rules: strength as darkness, width and opacity, groups as colors, selection as an ink ring.</p>
    <div class="two-up">
      <figure class="diagram">
        <figcaption>
          <h3>Diagram: by connection strength (default)</h3>
          <p class="visually-hidden">IL1B and 13 related genes in blood vessel, with edges darker and wider as the connection gets stronger; the strongest is IL1R1 at 0.97.</p>
        </figcaption>
        <NetworkDiagram mode="strength" />
        <KeyLegend title="Connection" mark="line" items={edgeItems} />
        <p class="caption">Query gene larger, with an ink outline, other genes white with a grey 600 outline. Only connections above the minimum confidence are drawn, and the legend starts its weakest band there, such as 0.84 to 0.9.</p>
      </figure>
      <figure class="diagram">
        <figcaption>
          <h3>Diagram: by module</h3>
          <p class="visually-hidden">The same 14 genes colored by module: inflammation, cytokine signaling, cell adhesion and other.</p>
        </figcaption>
        <NetworkDiagram mode="module" />
        <KeyLegend title="Module" items={moduleItems} />
        <p class="caption">Genes filled with the module scale. Connections keep the same strength encoding.</p>
      </figure>
    </div>
    <div class="selection-row">
      <figure class="diagram">
        <figcaption>
          <h3>Diagram: IL1R1 selected</h3>
          <p class="visually-hidden">IL1R1 selected with an ink ring; genes not connected to it fade to 30%.</p>
        </figcaption>
        <NetworkDiagram mode="selected" />
      </figure>
      <div class="selection-notes">
        <h3>Selection and labels</h3>
        <ul class="points">
          <li>Selection is a 2px ink ring around the node, never a green fill. Unrelated nodes and edges fade to 30%; nothing moves. Hover works the same way with a dashed ring, fading to 20%.</li>
          <li>The selected gene’s details open in the drawer beside the graph, as on the Modals and drawers page.</li>
          <li>Starring a process or tissue rings its genes in that set’s categorical color, with a light hull behind them. A gene in several starred sets gets one ring per set, stacked outward in the order they were starred. A 1px ink edge outside the rings keeps light colors visible on white.</li>
          <li>Labels are Lato Bold 12 ink on a white pill above the gene, drawn over every connection, so lines never cross the text. The query gene is 14px.</li>
          <li>Query genes are placed first, then the best connected genes. A label whose spot is taken moves below, right or left of its gene; with no free spot, it shows on hover or selection.</li>
          <li>In the module graph, each module has a soft outline in its color, with its label on the top edge at 14px on screen at any zoom.</li>
          <li>Node size stays fixed in network graphs, which keeps dense graphs calm and comparable. Module graphs size each gene by 1 plus its connections in the result, as humanbase.io does, from 12px to 20px, with the most connected gene in the middle of its module.</li>
        </ul>
      </div>
    </div>
    <h3 class="subhead">Interaction</h3>
    <DocTable caption="How the network graphs respond" columns={['Part', 'Uses']} widths={['300px']}>
      {
        aroundRenderer.map(([part, uses, link]) => {
          const [before, after] = link ? uses.split(link.text) : [uses];
          return (
            <tr>
              <th scope="row">{part}</th>
              <td>{before}{link && <a href={link.href}>{link.text}</a>}{after}</td>
            </tr>
          );
        })
      }
    </DocTable>
    <h3 class="subhead">What differs from humanbase.io</h3>
    <p class="subhead-lead">The look and every function match humanbase.io; these changes make the graphs easier to read.</p>
    <DocTable caption="What differs from humanbase.io" columns={['Change', 'Why']} widths={['440px']}>
      {requests.map(([request, why]) => <tr><th scope="row">{request}</th><td>{why}</td></tr>)}
    </DocTable>
  </DocSection>

  <DocSection title="Heatmaps" lead="Rows and columns of colored cells. The legend sits directly beside the heatmap, never in a separate panel, and every cell’s value is in its data tooltip.">
    <div class="two-up">
      <HeatmapDiagram
        title="Sequential: score with IL1B by tissue"
        summary="Scores with IL1B for 8 genes across 8 tissues; blood vessel is highest for every gene, and CCL2 in brain is not available."
        scale={tissueScores.scale}
        columns={tissueScores.columns}
        rows={tissueScores.rows}
        rowLabel="gene"
      />
      <HeatmapDiagram
        title="Diverging: predicted effect on IL1B expression"
        summary="Predicted effect of 5 variants on IL1B expression in 6 tissues; rs33944208 and rs16944 increase it most, rs1143634 lowers it."
        scale={variantEffects.scale}
        columns={variantEffects.columns}
        rows={variantEffects.rows}
        rowLabel="variant"
      />
    </div>
    <ul class="points">
      <li>Cells are separated by a 1px white gap, so neighboring cells of similar color still read as separate values.</li>
      <li>Missing values are white with a grey outline and a diagonal line, labeled “Not available” in the tooltip. Never a color from the scale, and never zero.</li>
      <li>Values are binned into the legend’s steps for display, five on a sequential scale and seven on a diverging one; the tooltip and the table view show the exact number.</li>
      <li>Clustering dendrograms are 1px grey 500 lines; they never use color.</li>
      <li>Variant IDs use the mono font; gene symbols are Lato Bold. Long column labels rotate 50°, never 90°.</li>
    </ul>
  </DocSection>

  <DocSection title="Charts" lead="Bars, lines and tracks. If color doesn’t encode anything, the marks are grey 600.">
    <div class="two-up">
      <BarChart
        title="Enriched GO terms"
        summary="Six enriched GO terms for IL1B’s network; inflammatory response is strongest at 11.9, and all are above the q = 0.05 line."
        bars={enrichedTerms}
        max={13}
        ticks={[0, 4, 8, 12]}
        axisTitle="−log10(q)"
        threshold={{ value: 1.3, label: 'q = 0.05' }}
      >
        <p class="caption">One series, so the bars are grey 600, sorted by value. The axis title includes the unit; the dashed line marks significance.</p>
      </BarChart>
      <EffectTrack
        title="Variant effects near the IL1B promoter"
        summary="Predicted effects on IL1B expression from 1 kb upstream to 1 kb downstream of the TSS; the largest effects sit just around the TSS, in both directions. Example values."
        effects={promoterTrack}
      >
        <ScaleLegend title="Effect on expression" scale="diverging" ticks={['Decrease', '0', 'Increase']} />
        <p class="caption">Direction uses step 5 of each side: blue 4.1:1 and orange 3.8:1 on white, both above the 3:1 needed for graphics. Position also carries direction, so color is a second cue.</p>
      </EffectTrack>
    </div>
    <ul class="points">
      <li>Axis labels and ticks: Lato 12 grey 600. Axis titles: Lato Bold 12 ink, always with units, such as −log10(q) or “Position relative to TSS”.</li>
      <li>Gridlines: 1px grey 200, only on the value axis. New charts have no borders, backgrounds or 3D effects; the existing network views keep their own style.</li>
      <li>Values at the end of bars use tabular figures and the formatting rules from the Tables page.</li>
      <li>Every chart has a “View as table” option with the same data, for screen readers and for copying.</li>
    </ul>
  </DocSection>

  <DocSection title="Variant score plot" lead="Sei, Beluga and Seqweaver results plot every variant’s score the way humanbase.io does, so a result reads the same on both sites. The data encoding is humanbase.io’s; axes, text, tooltip and brush use our tokens.">
    <VariantScorePlot variants={exampleVariants} score={{ key: 'impact', label: 'Disease impact score' }} selected={selectedVariant} summary="The Seqweaver example’s variants by genome position, colored by chromosome." />
    <ul class="points">
      <li>Manhattan (x titled Genome) joins the chromosomes that have variants, each as long as its variants span, with a gap of 18/800 of the total span between them. Ticks read chromosome:position, such as chr3:12598855. Score Rank (x titled Rank) puts the highest score at 1.</li>
      <li>Points are 12px, colored by chromosome (viz.chromosome) in both plot styles, or by sequence class group (viz.seqclass) on Sei’s Color style. The y axis always includes 0.</li>
      <li>The overview under the plot shows every variant over its chromosome’s band at half strength: chromosome colors, or viz.band.dark and viz.band.light in turn while points show sequence classes, or one viz.band.neutral band for Score Rank. Drag across it, or use the mouse wheel over the plot, to zoom.</li>
      <li>Hover or arrow keys open the Data tooltip; Enter selects; + and - zoom. The selected variant has a 2px ink ring, and an ink dot in the overview. The variants table beside the plot is its text alternative.</li>
    </ul>
  </DocSection>

  <DocSection title="Accessibility" lead="Charts are images to a screen reader unless we give them words.">
    <DocTable caption="Chart accessibility rules" columns={['Rule', 'Detail']} widths={['324px']}>
      {accessibility.map(([rule, detail]) => <tr><th scope="row">{rule}</th><td>{detail}</td></tr>)}
    </DocTable>
  </DocSection>

  <DocSection title="Do and don’t">
    <ul class="pairs" style="--columns: 2">
      <li class="pair pair-do">
        <div class="pair-stage"><ScaleRamp steps={sequential} size="small" /></div>
        <h3>Do. One hue for amounts</h3>
        <p>Darker means more, in color and in grey scale.</p>
      </li>
      <li class="pair pair-dont">
        <div class="pair-stage"><ScaleRamp steps={rainbow} size="small" /></div>
        <h3>Don’t. A rainbow scale</h3>
        <p>Yellow looks brightest though it isn’t the highest value, and the bands create edges that aren’t in the data.</p>
      </li>
      <li class="pair pair-do">
        <div class="pair-stage"><ScaleRamp steps={diverging} size="small" /></div>
        <h3>Do. Blue to orange for direction</h3>
        <p>The two sides stay apart for every kind of color vision.</p>
      </li>
      <li class="pair pair-dont">
        <div class="pair-stage"><ScaleRamp steps={redGreen} size="small" /></div>
        <h3>Don’t. Red to green for direction</h3>
        <p>Under protanopia the two ends lose about 83% of their difference.</p>
      </li>
      <li class="pair pair-do">
        <div class="pair-stage">
          <svg class="mini-node" viewBox="0 0 120 40" aria-hidden="true">
            <circle class="ring" cx="20" cy="20" r="11" /><circle class="plain" cx="20" cy="20" r="6" /><text x="40" y="24">IL1R1</text>
          </svg>
        </div>
        <h3>Do. Ink ring for selection</h3>
        <p>Selection looks the same in every chart, and never like data.</p>
      </li>
      <li class="pair pair-dont">
        <div class="pair-stage">
          <svg class="mini-node" viewBox="0 0 120 40" aria-hidden="true">
            <circle class="green" cx="20" cy="20" r="7" /><text x="40" y="24">IL1R1</text>
          </svg>
        </div>
        <h3>Don’t. Green fill for selection</h3>
        <p>A green node reads as a data value, or as “good”.</p>
      </li>
    </ul>
  </DocSection>

  <DocSection title="Specs and tokens" lead="Hard-coded for now. They will become Figma variables once the first product pages are designed.">
    <DocTable caption="Data visualization tokens and values" columns={['Token', 'Value']} widths={['404px']}>
      {specs.map(([token, value]) => <tr><th scope="row"><code>{token}</code></th><td><code>{value}</code></td></tr>)}
    </DocTable>
  </DocSection>
</DocsLayout>

