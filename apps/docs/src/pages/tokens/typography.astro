---
import { typeScale } from '../../data/typeScale';
import DocsLayout from '../../layouts/DocsLayout.astro';
---

<DocsLayout title="Type tokens" description="Text styles: Cabin for headings, Lato for text, Atkinson Hyperlegible Mono for code.">
  <p>Headings use Cabin, running text uses Lato, and code uses Atkinson Hyperlegible Mono. Use a style with <code>font: var(--type-…)</code> and its <code>-tracking</code> partner for letter spacing.</p>

  <div class="table-scroll" role="region" aria-labelledby="styles-caption" tabindex="0">
  <table class="type-table">
    <caption id="styles-caption" class="visually-hidden">Text styles</caption>
    <thead>
      <tr><th scope="col">Style</th><th scope="col">Sample</th><th scope="col">Font, weight, size and line height</th></tr>
    </thead>
    <tbody>
      {
        typeScale.map((type) => (
          <tr>
            <th scope="row"><code>{type.cssVar}</code></th>
            <td style={type.style}>Gene networks across tissues</td>
            <td>{type.family}, {type.weight}, {type.size}px / {type.lineHeight}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  </div>
</DocsLayout>

<style>
  .type-table {
    width: 100%;
    border-collapse: collapse;
  }

  .type-table th,
  .type-table td {
    padding: var(--space-4) var(--space-3);
    text-align: start;
    vertical-align: middle;
    border-block-end: var(--border-width-1) solid var(--border-subtle);
  }

  .type-table th {
    font-weight: 400;
  }
</style>
