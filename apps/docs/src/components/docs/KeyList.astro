---
interface Props {
  items: [term: string, description: string][];
  termWidth?: string;
}

const { items, termWidth } = Astro.props;
---

<dl class="key-list" style={termWidth ? `--key-term-width: ${termWidth}` : undefined}>
  {
    items.map(([term, description]) => (
      <div>
        <dt>{term}</dt>
        <dd>{description}</dd>
      </div>
    ))
  }
</dl>
