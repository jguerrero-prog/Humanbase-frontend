---
import { edgeCurve } from '@humanbase/graph';

const center = [426, 205];
const neighbors = [
  [306, 145],
  [536, 125],
  [276, 265],
  [556, 275],
  [426, 85],
  [386, 315],
  [486, 325],
  [196, 195],
  [646, 205],
];
---

<svg class="network-sketch" viewBox="0 0 852 410" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
  {neighbors.map(([x = 0, y = 0]) => <path d={edgeCurve({ x: center[0] ?? 0, y: center[1] ?? 0 }, { x, y })} />)}
  {neighbors.map(([x, y]) => <circle cx={x} cy={y} r="6" />)}
  <circle class="network-sketch-query" cx={center[0]} cy={center[1]} r="9" />
</svg>

<style>
  .network-sketch {
    inline-size: 100%;
    block-size: 100%;
    background: var(--surface-page);
    border-radius: var(--radius-sm);
  }

  path {
    fill: none;
    stroke: var(--border-default);
    stroke-width: 1.5;
  }

  circle {
    fill: var(--surface-page);
    stroke: var(--text-secondary);
    stroke-width: 1.5;
  }

  .network-sketch-query {
    stroke: var(--text-default);
    stroke-width: 2.5;
  }
</style>
