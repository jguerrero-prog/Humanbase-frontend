{
  "name": "humanbase-frontend",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "pnpm --filter @humanbase/web dev",
    "dev:docs": "pnpm --filter @humanbase/docs dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && stylelint \"**/*.css\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "playwright test -c playwright.live.config.ts --project=live",
    "test:live:jobs": "playwright test -c playwright.live.config.ts --project=jobs",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "tokens": "pnpm --filter @humanbase/tokens build",
    "api:generate": "node scripts/generate-api-types.mjs",
    "api:verify": "node scripts/verify-api.mjs",
    "samples:record": "node scripts/record-samples.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
